{
  "name": "圖影轉PDF.HTML報告｜呈易科技",
  "short_name": "圖影轉PDF.HTML報告",
  "description": "照片／影片抓格／GIF 壓縮後轉 PDF 或網頁報告，內含圖片工具（HEIC/RAW 轉檔、裁剪、浮水印、拼接）、標註量測、PDF 檢視。全程在裝置本機處理，可離線使用。",
  "lang": "zh-Hant-TW",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "id": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f4f6f6",
  "theme_color": "#0d6b6e",
  "categories": [
    "productivity",
    "utilities",
    "photo"
  ],
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            "application/pdf",
            ".pdf",
            "image/jpeg",
            ".jpg",
            ".jpeg",
            "image/png",
            ".png",
            "image/webp",
            ".webp",
            "image/heic",
            ".heic",
            "application/zip",
            ".zip",
            "image/gif",
            ".gif",
            "video/mp4",
            ".mp4",
            "video/quicktime",
            ".mov",
            "video/webm",
            ".webm",
            "video/3gpp",
            ".3gp",
            "image/heif",
            ".heif",
            "image/tiff",
            ".tif",
            ".tiff"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./viewer.html?fh=1",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      },
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "./index.html?fh=img",
      "accept": {
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/png": [
          ".png"
        ],
        "image/webp": [
          ".webp"
        ],
        "image/gif": [
          ".gif"
        ]
      },
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}